<?xml version="1.0" encoding="UTF-8"?>
<!-- Merged into the generated Info.plist. Only keys with no INFOPLIST_KEY_*
     build-setting equivalent belong here; everything else lives in project.yml. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Native launch screen: brand background + the app mark, no storyboard.
	     Colours and image come from Resources/Assets.xcassets. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<!-- Uses no non-exempt encryption; skips the yearly export-compliance prompt
	     on every TestFlight/App Store upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
